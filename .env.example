# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (transaction pooler) - for scripts/seed.ts, scripts/apply-migrations.mjs
SUPABASE_DB_URL=

# Claude (agent-server, evals)
ANTHROPIC_API_KEY=
# Set once Task 12's Haiku-vs-Sonnet comparison decides (SYSTEM-DESIGN.md §4)
ANTHROPIC_MODEL=

# Vapi (docs.vapi.ai)
# Safe in the browser - the web voice page's public key + the configured assistant
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# Server-only - scripts/configure-vapi.ts (creates/updates the assistant)
VAPI_PRIVATE_KEY=
# A shared secret sent as a custom X-Vapi-Server-Secret header (not Authorization - Vapi reserves that for its own credential system on a custom-llm model); agent-server checks it on every /vapi/* request
VAPI_SERVER_SECRET=

# agent-server <-> mcp-server (SYSTEM-DESIGN.md §5: localhost only, bearer token)
MCP_SERVER_URL=http://127.0.0.1:8090/mcp
MCP_SERVER_TOKEN=
MCP_PORT=8090
AGENT_SERVER_PORT=8091

# The signed short-lived token agent-server puts in Vapi's call metadata (§3) - a random 32+ byte secret
CONVERSATION_TOKEN_SECRET=

# The public app's demo/reviewer account (web/app/sign-in/actions.ts's demoSignIn) - a real account like any other, subject to the same daily call limit. Created/updated via scripts/create-demo-user.mjs.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=

# Public address of the web app (Vercel) - links in Discord messages and the redirect in invite emails (scripts/invite-user.mjs)
APP_URL=
# Same address, exposed to the browser - the voice page's POST /api/conversations and /api/text (§11.7). Safe in the browser: it's just where those two public endpoints live, not a credential.
NEXT_PUBLIC_AGENT_SERVER_URL=http://127.0.0.1:8091

# Discord (notify/discord.ts, SYSTEM-DESIGN.md §10): #alerts needs a person, #activity is the feed
DISCORD_ALERTS_WEBHOOK_URL=
DISCORD_ACTIVITY_WEBHOOK_URL=
# Claude spend per UTC day that posts one #alerts message (default 2; 0 turns it off)
DAILY_SPEND_ALERT_USD=

# Testing (TESTING-GUIDE.md): unset/false runs live; true replays recordings, $0
REPLAY_MODE=
