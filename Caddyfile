# Task 13 (SYSTEM-DESIGN.md §12): free HTTPS via sslip.io + Caddy's own
# automatic Let's Encrypt cert issuance/renewal. agent-server owns every
# public route (/health, /api/conversations, /api/text, /api/text/end,
# /vapi/chat/completions, /vapi/events) and checks its own credential on
# each one, so a single reverse_proxy for everything is correct here.
# Caddy's own warning lines (e.g. "aborting with incomplete response")
# include the full request - Authorization is redacted by Caddy itself, but
# the X-Vapi-Server-Secret header isn't, and a query string would be logged
# as-is. Both are stripped from every log line here, for the default logger
# that those warnings go to.
{
	log default {
		format filter {
			wrap json
			fields {
				request>headers>X-Vapi-Server-Secret delete
				request>uri query {
					delete access_token
				}
			}
		}
	}
}

129-146-79-96.sslip.io {
	reverse_proxy agent-server:8091
}
