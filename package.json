{
  "name": "relaypay-support-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:agent-server": "pnpm --filter agent-server dev",
    "dev:mcp-server": "pnpm --filter mcp-server dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:replay": "vitest run tests/replay",
    "test:retrieval": "vitest run tests/retrieval",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "tsx evals/src/run.ts",
    "seed": "tsx scripts/seed.ts",
    "ingest": "tsx scripts/ingest-knowledge.ts",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "set-alert-secrets": "node scripts/set-alert-secrets.mjs",
    "create-staff-user": "node scripts/create-staff-user.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@anthropic-ai/sdk": "^0.128.0",
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.1",
    "jsdom": "^30.1.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
