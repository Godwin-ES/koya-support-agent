{
  "name": "mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "start": "tsx src/http.ts",
    "build": "echo \"no separate build step - runs via tsx directly in the Dockerfile\" && exit 0",
    "lint": "echo \"(no lint config yet for mcp-server)\"",
